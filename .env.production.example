# =============================================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# =============================================================================
# Copy to the server as `.env`, then fill in every value marked CHANGEME.
#
#   scp .env.production.example deploy@host:/var/www/screenshut-telemetry/.env
#
# This file is deliberately separate from `.env.example`, which stays a
# local/CI baseline: CI does `cp .env.example .env` and then runs
# `migrate:fresh --force`, which AppServiceProvider::boot() blocks outright
# when APP_ENV=production. Do not merge the two.
#
# After copying, on the server:
#   php artisan key:generate            # only on a brand-new install
#   php artisan migrate --force
#   php artisan config:cache route:cache view:cache event:cache
#   php artisan storage:link
#
# Requires PHP >= 8.4.1 (composer.json is ^8.4). A bare `php` may be 8.2/8.3 on
# this host — pin the full path in cron and supervisor unit files.
# =============================================================================

# --- Core ---------------------------------------------------------------
APP_NAME=Screenshut
APP_ENV=production
# CHANGEME — generate once with `php artisan key:generate`, then never rotate
# without re-encrypting existing encrypted columns.
APP_KEY=
APP_DEBUG=false
# CHANGEME — must be the real public https origin. Passkeys derive their relying
# party ID from this (config/fortify.php), and AppServiceProvider forces https.
APP_URL=https://screen.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ------------------------------------------------------------
# `debug` leaks request context into logs; `warning` is the production floor.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (Neon managed PostgreSQL) ---------------------------------
# The Neon project MUST be in the same region as the droplet (eu-central-1 /
# Frankfurt for FRA1). A cross-region database pays its round trip on EVERY query,
# and a single endpoint runs many — see docs/runbooks/provision-droplet.md §3.
#
# Use the POOLED host here (hostname contains `-pooler`). Verified safe: this app uses
# no advisory locks, no LISTEN/NOTIFY, and no session-level SET; every lockForUpdate()
# is inside a DB::transaction(), so it pools cleanly in transaction mode.
# Run migrations against the DIRECT host instead (same name without `-pooler`).
DB_CONNECTION=pgsql
# CHANGEME — e.g. ep-xxxx-pooler.eu-central-1.aws.neon.tech
DB_HOST=
DB_PORT=5432
DB_DATABASE=screenshut_telemetry
# CHANGEME
DB_USERNAME=
DB_PASSWORD=
# Neon refuses plaintext connections — `require` is mandatory, not optional.
DB_SSLMODE=require

# --- Session ------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Encrypt session payloads at rest — cheap, and sessions carry admin identity.
SESSION_ENCRYPT=true
SESSION_PATH=/
# CHANGEME — the cookie domain, e.g. `.example.com` to share across subdomains.
SESSION_DOMAIN=
# HTTPS-only cookies. The app forces https anyway; this makes it enforceable.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache / Queue / Redis ----------------------------------------------
# Redis, not database: Horizon requires it, and the trending feed and
# recommendation pools are Redis ZSET-backed.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
# CHANGEME — leave as `null` only if Redis is bound to localhost and firewalled.
REDIS_PASSWORD=null
REDIS_PORT=6379
# Namespaces this app's keys so a shared Redis doesn't collide.
REDIS_PREFIX=screenshut_production_

# --- Filesystem / R2 ----------------------------------------------------
FILESYSTEM_DISK=r2
SOCIAL_UPLOADS_DISK=r2
SOCIAL_MEDIA_DISK=r2

# Cloudflare R2 — deliberately a separate S3-compatible disk from the AWS_*
# block (see config/filesystems.php). Region is always "auto"; path-style
# addressing is required (R2 has no virtual-hosted-style).
# CHANGEME (all five)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=true
# Public bucket URL or Cloudflare custom domain. Without it, no R2-backed post
# can render for a viewer.
R2_PUBLIC_URL=

SOCIAL_UPLOADS_PRESIGN_TTL_SECONDS=600
SOCIAL_UPLOADS_MAX_SIZE_BYTES=10485760

# --- Mail ---------------------------------------------------------------
# CHANGEME — `log` silently swallows email verification and password resets.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Search -------------------------------------------------------------
# Scout searches PostgreSQL directly.
SCOUT_DRIVER=database
SCOUT_QUEUE=true

# --- Monitoring: Pulse (production) -------------------------------------
# Pulse is the production monitoring surface. Telescope is require-dev and is
# never loaded here (see AppServiceProvider::registerTelescope()).
# The dashboard lives at /pulse behind the admin-only `viewPulse` gate.
PULSE_ENABLED=true
PULSE_PATH=pulse

# Redis ingest keeps request handling off the write path: requests push to a
# Redis stream, and a separate `pulse:work` daemon drains it into Postgres.
# Using the `storage` driver instead writes to Postgres on every request.
PULSE_INGEST_DRIVER=redis
PULSE_STORAGE_DRIVER=database
# How long aggregates are kept. Independent of TELEMETRY_RETENTION_DAYS —
# different data, different lifecycle.
PULSE_STORAGE_KEEP="7 days"
PULSE_INGEST_KEEP="7 days"

# Sample rates: 1 = record everything. Lower these (e.g. 0.1) if Pulse's own
# write volume becomes material at higher traffic.
PULSE_SLOW_QUERIES_THRESHOLD=1000
PULSE_SLOW_REQUESTS_THRESHOLD=1000
PULSE_SLOW_JOBS_THRESHOLD=1000
PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=1000
# Slow-query SQL is stored. Location capture adds the calling file/line.
PULSE_SLOW_QUERIES_LOCATION=true
PULSE_EXCEPTIONS_LOCATION=true

# --- Monitoring: Horizon ------------------------------------------------
# Three supervisors (config/horizon.php) map 1:1 to the default/security/media
# queues. Dashboard at /horizon behind the admin-only `viewHorizon` gate.
HORIZON_PREFIX=horizon_production_

# Worst-case Horizon RAM = (default x 128MB) + (security x 128MB) + (media x 256MB),
# using the per-worker `memory` ceilings in config/horizon.php's `defaults`.
#   3 / 1 / 2  ->  384 + 128 + 512 = ~1.0 GB   (sized for 2 vCPU / 4 GB)
#   6 / 2 / 4  ->  768 + 256 + 1024 = ~2.0 GB  (needs 8 GB+)
# PHP-FPM, PostgreSQL, Redis and both Pulse daemons share the rest. Media workers also
# shell out to Tesseract, whose memory sits OUTSIDE PHP's limit — keep media <= vCPU count,
# since image decode and OCR are CPU-bound.
HORIZON_DEFAULT_MAX_PROCESSES=3
HORIZON_SECURITY_MAX_PROCESSES=1
HORIZON_MEDIA_MAX_PROCESSES=2

# --- Health check -------------------------------------------------------
# CHANGEME — shared secret an uptime monitor sends as X-Health-Check-Secret to
# reach /up/deep (dependency probes + queue backlog). Unset means the endpoint
# 404s for everyone, so leaving this blank disables deep health monitoring.
# Generate: `openssl rand -hex 32`
HEALTH_CHECK_SECRET=

# --- Auth / tokens ------------------------------------------------------
# Prefixing Sanctum tokens lets GitHub/GitLab secret scanning catch a leaked
# token. Pick a short distinctive prefix and never change it afterwards —
# existing tokens are hashed at rest and cannot be re-prefixed.
SANCTUM_TOKEN_PREFIX=

# Defaults to APP_KEY if unset. Set it explicitly so a future APP_KEY rotation
# does not invalidate every registered passkey.
# CHANGEME — generate: `openssl rand -base64 32`
PASSKEYS_USER_HANDLE_SECRET=

# --- Social auth --------------------------------------------------------
# OAuth "Web application" client ID + secret from Google Cloud Console,
# consumed by Socialite (App\Services\SocialAuth\GoogleTokenVerifier).
# CHANGEME
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app credentials, used to verify Facebook Login tokens via the Graph API.
# The Android client is a fail-closed stub today; leave blank until it ships.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Push notifications -------------------------------------------------
# FIREBASE_CREDENTIALS_PATH is an absolute path to a service-account JSON key
# (Firebase Console > Project Settings > Service Accounts). Store it OUTSIDE
# the web root, chmod 600, owned by the PHP user. Never commit it.
# Push sending is silently skipped, not an error, until both are set.
# CHANGEME
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=/etc/screenshut/firebase-service-account.json

# --- Retention ----------------------------------------------------------
TELEMETRY_RETENTION_DAYS=90
SOCIAL_ANALYTICS_RETENTION_DAYS=90
SOCIAL_POST_RETENTION_DAYS=30
SOCIAL_ACCOUNT_RETENTION_DAYS=30
USER_SESSION_LIFETIME_DAYS=90

# --- Security outbox / delivery -----------------------------------------
SECURITY_OUTBOX_STALE_MINUTES=15
SECURITY_DELIVERY_TIMEOUT_SECONDS=30

# --- Media pipeline / OCR -----------------------------------------------
SOCIAL_MEDIA_CLEANUP_GRACE_MINUTES=60
SOCIAL_MEDIA_JOB_TIMEOUT_SECONDS=60
SOCIAL_MEDIA_ANALYSIS_TTL_MINUTES=30
# Must be installed on the server and on $PATH, or an absolute path.
SOCIAL_OCR_BINARY=tesseract
SOCIAL_OCR_LANGUAGE=eng
SOCIAL_OCR_TIMEOUT_SECONDS=45
SOCIAL_OCR_MAX_CHARACTERS=50000

# --- Social / moderation ------------------------------------------------
SOCIAL_MESSAGE_REQUEST_REJECTION_COOLDOWN_DAYS=30
# Comma-separated. Blank disables offensive-term filtering entirely.
SOCIAL_OFFENSIVE_TERMS=

# --- Recommendations / trending -----------------------------------------
SOCIAL_RECOMMENDATION_POOL_PREFIX=recommendations:v1:hot
SOCIAL_RECOMMENDATION_POOL_TTL_MINUTES=60
SOCIAL_RECOMMENDATION_TOTAL_LIMIT=250
SOCIAL_RECOMMENDATION_RANKING_VERSION=v1
SOCIAL_RECOMMENDATION_SESSION_TTL_MINUTES=30

# --- Frontend build -----------------------------------------------------
VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# PROCESSES THIS APP NEEDS ON THE SERVER (none are optional)
# =============================================================================
#  1. Scheduler — cron, every minute:
#       * * * * * /usr/bin/php8.4 /var/www/screenshut-telemetry/artisan schedule:run >> /dev/null 2>&1
#     16 scheduled tasks depend on this (retention pruning, security outbox
#     dispatch, trending refresh, analytics aggregation, health capture).
#
#  2. Horizon — supervisor, one process:
#       /usr/bin/php8.4 /var/www/screenshut-telemetry/artisan horizon
#     Do NOT also run `queue:work`; Horizon owns all three queues.
#
#  3. Pulse ingest — supervisor, one process (required by PULSE_INGEST_DRIVER=redis):
#       /usr/bin/php8.4 /var/www/screenshut-telemetry/artisan pulse:work
#
#  4. Pulse server stats — supervisor, one process per server:
#       /usr/bin/php8.4 /var/www/screenshut-telemetry/artisan pulse:check
#
# On deploy, restart the daemons so they pick up new code:
#   php artisan horizon:terminate && php artisan pulse:restart
# =============================================================================
