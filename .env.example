# Local development + CI baseline. For a server, copy .env.production.example
# instead — this file intentionally keeps APP_ENV=local/APP_DEBUG=true, and CI
# does `cp .env.example .env` then `migrate:fresh --force`, which the production
# guard in AppServiceProvider::boot() blocks outright.

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Neon: use the POOLED host here (hostname contains `-pooler`).
DB_HOST=database
# Direct/unpooled host used only by migration/DDL tooling. Local Docker uses the same server.
DB_DIRECT_HOST=database
# Must stay true on Neon's pooled endpoint: server-side prepared statements inside an explicit
# transaction fail there with a misleading SQLSTATE 25P02 on the *next* statement. Only set this
# to false on a non-pooled Postgres where server-side prepare is wanted. See config/database.php.
DB_EMULATE_PREPARES=true
DB_PORT=5432
DB_DATABASE=screenshut_telemetry
DB_USERNAME=screenshut
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SECURITY_OUTBOX_STALE_MINUTES=15
SECURITY_DELIVERY_TIMEOUT_SECONDS=30
USER_SESSION_LIFETIME_DAYS=90
SOCIAL_MEDIA_CLEANUP_GRACE_MINUTES=60
SOCIAL_MEDIA_JOB_TIMEOUT_SECONDS=60
SOCIAL_MEDIA_ANALYSIS_TTL_MINUTES=30
SOCIAL_OCR_BINARY=tesseract
SOCIAL_OCR_LANGUAGE=eng
SOCIAL_OCR_TIMEOUT_SECONDS=45
SOCIAL_OCR_MAX_CHARACTERS=50000
SOCIAL_MESSAGE_REQUEST_REJECTION_COOLDOWN_DAYS=30
SOCIAL_OFFENSIVE_TERMS=
SOCIAL_ANALYTICS_RETENTION_DAYS=90
SOCIAL_RECOMMENDATION_POOL_PREFIX=recommendations:v1:hot
SOCIAL_RECOMMENDATION_POOL_TTL_MINUTES=60
SOCIAL_RECOMMENDATION_TOTAL_LIMIT=250
SOCIAL_RECOMMENDATION_RANKING_VERSION=v1
SOCIAL_RECOMMENDATION_SESSION_TTL_MINUTES=30
TELEMETRY_RETENTION_DAYS=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Scout searches PostgreSQL directly. Tests use the collection driver so the suite can
# remain SQLite-backed while PostgreSQL integration tests verify full-text relevance.
SCOUT_DRIVER=database
SCOUT_QUEUE=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 — a separate S3-compatible disk from the AWS_* block above, deliberately not
# reusing those vars (see config/filesystems.php's "r2" disk / docs/SECURITY.md). Region is
# always "auto" for R2; path-style addressing is required (R2 doesn't support virtual-hosted-style).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=true
# Keep the bucket private. Media is delivered through expiring signed application URLs.
# PRODUCTION: all three of these must be r2. Leaving them at the local-development defaults
# writes user media to the app server's own disk, which "works" in testing and then silently
# loses every upload the next time the server is rebuilt. See docs/runbooks/private-media-cutover.md.
SOCIAL_MEDIA_DISK=public
SOCIAL_UPLOADS_DISK=r2
SOCIAL_PRIVATE_MEDIA_DISK=local
# Redirect to a presigned object-store URL instead of streaming bytes through PHP. Only applies
# to disks that support presigning, so local development streams either way.
SOCIAL_MEDIA_OFFLOAD_ENABLED=true
SOCIAL_MEDIA_OFFLOAD_TTL_SECONDS=120
SOCIAL_MEDIA_URL_TTL_SECONDS=1200
SOCIAL_PUBLIC_MEDIA_CACHE_SECONDS=300
SOCIAL_IMAGE_MAX_DIMENSION=12000
SOCIAL_IMAGE_MAX_PIXELS=40000000
SOCIAL_REMOTE_AVATAR_MAX_BYTES=5242880
SOCIAL_REMOTE_AVATAR_MAX_REDIRECTS=2

# OAuth "Web application" client ID + secret from Google Cloud Console. Consumed by Socialite
# (App\Services\SocialAuth\GoogleTokenVerifier) to call Google's userinfo endpoint with the
# access token Android obtains via its Authorization API (Identity.getAuthorizationClient()).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app credentials, used to verify Facebook Login access tokens via the Graph API.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Firebase Cloud Messaging push notifications. FIREBASE_PROJECT_ID is the Firebase
# project ID (Project Settings > General); FIREBASE_CREDENTIALS_PATH is an absolute path
# to a service-account JSON key (Project Settings > Service Accounts > Generate new
# private key) — never commit that file. Push sending is silently skipped, not an error,
# until both are set.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
# Custom-backend App Check rollout: off -> monitor -> enforce. Project number is numeric;
# allowed app IDs are comma-separated Firebase App IDs (for example 1:123:android:abc).
FIREBASE_APP_CHECK_MODE=off
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_CHECK_ALLOWED_APP_IDS=

VITE_APP_NAME="${APP_NAME}"

# Shared secret an uptime monitor sends as the X-Health-Check-Secret header to reach
# /up/deep (dependency probes + queue backlog — not safe to leave public). Unset means
# the endpoint 404s for everyone.
HEALTH_CHECK_SECRET=

# Telescope is a require-dev package, `dont-discover`ed, and registered only in
# local/testing by AppServiceProvider::registerTelescope() — it does not exist on a
# production box at all. Set false to stop recording locally without uninstalling.
TELESCOPE_ENABLED=true

# Pulse is the production monitoring surface and is enabled in every environment
# (the test suite disables it via phpunit.xml). Locally the default `storage` ingest
# writes straight to the DB, so no `pulse:work` daemon is needed; production uses the
# redis ingest instead — see .env.production.example.
PULSE_ENABLED=true
PULSE_PATH=pulse
PULSE_INGEST_DRIVER=storage
PULSE_STORAGE_KEEP="7 days"
